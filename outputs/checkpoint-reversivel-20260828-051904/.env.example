
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Enable the safe change-aware Firestore sync only after emulator and pilot validation.
VITE_FIRESTORE_CHANGE_AWARE_SYNC=false
VITE_FIRESTORE_INCREMENTAL_SYNC=false
# Optional pilot allowlist. Empty means all authenticated users when incremental sync is enabled.
VITE_FIRESTORE_INCREMENTAL_SYNC_PILOT_UIDS=
